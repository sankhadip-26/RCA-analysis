    AS sep_w3_pdp_to_atc_pct,
  ROUND(COALESCE(SAFE_DIVIDE(sep_w3_qty, sep_w3_pdp) * 100, 0), 2)
    AS sep_w3_cvr_pct,
  ROUND(sep_w3_avg_inventory, 2) AS sep_w3_avg_inventory,
  ROUND(sep_w3_avg_sp, 2) AS sep_w3_avg_sp,

  ROUND(sep_w3_brand_offer_sp, 2) AS sep_w3_avg_brand_offer_sp,

  -- SEPTEMBER TOTAL
  sep_total_qty,
  ROUND(sep_total_gmv / 100000, 2) AS sep_total_gmv_lakhs,
  sep_total_pdp,
  sep_total_atc,
  ROUND(COALESCE(SAFE_DIVIDE(sep_total_atc, sep_total_pdp) * 100, 0), 2)
    AS sep_total_pdp_to_atc_pct,
  ROUND(COALESCE(SAFE_DIVIDE(sep_total_qty, sep_total_pdp) * 100, 0), 2)
    AS sep_total_cvr_pct,
  ROUND(sep_total_avg_inventory, 2) AS sep_total_avg_inventory,
  ROUND(sep_total_avg_sp, 2) AS sep_total_avg_sp,

  ROUND(sep_total_brand_offer_sp, 2) AS sep_total_avg_brand_offer_sp,

  -- OCTOBER WEEK 1
  oct_w1_qty,
  ROUND(oct_w1_gmv / 100000, 2) AS oct_w1_gmv_lakhs,
  oct_w1_pdp,
  oct_w1_atc,
  ROUND(COALESCE(SAFE_DIVIDE(oct_w1_atc, oct_w1_pdp) * 100, 0), 2)
