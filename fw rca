  ROUND(aug_total_avg_sp, 2) AS aug_total_avg_sp,
  ROUND(aug_total_brand_offer_sp, 2) AS aug_total_avg_brand_offer_sp,

  -- SEPTEMBER WEEK 1
  sep_w1_qty,
  ROUND(sep_w1_gmv / 100000, 2) AS sep_w1_gmv_lakhs,
  sep_w1_pdp,
  sep_w1_atc,
  ROUND(COALESCE(SAFE_DIVIDE(sep_w1_atc, sep_w1_pdp) * 100, 0), 2)
    AS sep_w1_pdp_to_atc_pct,
  ROUND(COALESCE(SAFE_DIVIDE(sep_w1_qty, sep_w1_pdp) * 100, 0), 2)
    AS sep_w1_cvr_pct,
  ROUND(sep_w1_avg_inventory, 2) AS sep_w1_avg_inventory,
  ROUND(sep_w1_avg_sp, 2) AS sep_w1_avg_sp,

  ROUND(sep_w1_brand_offer_sp, 2) AS sep_w1_avg_brand_offer_sp,

  -- SEPTEMBER WEEK 2
