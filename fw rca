  ROUND(nov_w3_gmv / 100000, 2) AS nov_w3_gmv_lakhs,
  nov_w3_pdp,
  nov_w3_atc,
  ROUND(COALESCE(SAFE_DIVIDE(nov_w3_atc, nov_w3_pdp) * 100, 0), 2)
    AS nov_w3_pdp_to_atc_pct,
  ROUND(COALESCE(SAFE_DIVIDE(nov_w3_qty, nov_w3_pdp) * 100, 0), 2)
    AS nov_w3_cvr_pct,
  ROUND(nov_w3_avg_inventory, 2) AS nov_w3_avg_inventory,
  ROUND(nov_w3_avg_sp, 2) AS nov_w3_avg_sp,

  ROUND(nov_w3_brand_offer_sp, 2) AS nov_w3_avg_brand_offer_sp,

  -- NOVEMBER TOTAL
  nov_total_qty,
  ROUND(nov_total_gmv / 100000, 2) AS nov_total_gmv_lakhs,
  nov_total_pdp,
  nov_total_atc,
  ROUND(COALESCE(SAFE_DIVIDE(nov_total_atc, nov_total_pdp) * 100, 0), 2)
    AS nov_total_pdp_to_atc_pct,
  ROUND(COALESCE(SAFE_DIVIDE(nov_total_qty, nov_total_pdp) * 100, 0), 2)
    AS nov_total_cvr_pct,
  ROUND(nov_total_avg_inventory, 2) AS nov_total_avg_inventory,
  ROUND(nov_total_avg_sp, 2) AS nov_total_avg_sp,

  ROUND(nov_total_brand_offer_sp, 2) AS nov_total_avg_brand_offer_sp,

  -- COMBINED GMV AND GRADING
  ROUND(total_gmv / 100000, 2) AS total_gmv_lakhs,
  ROUND(cumulative_gmv_share * 100, 2) AS cumulative_gmv_contribution_pct,
  grade

FROM graded

ORDER BY
  brand,
  total_gmv DESC,
  style_code;
