WITH date_range AS (
  SELECT
    DATE '2026-08-01' AS start_date,
    DATE '2026-11-22' AS end_date
),

-- =====================================================
-- 1. SALES BASE
-- =====================================================

base AS (
  SELECT
    DATE(oo.create_date + INTERVAL 330 MINUTE) AS order_date,
    nt.division AS division,
    pb.name AS brand,
    pp.variant_id AS style_code,

    SAFE_CAST(oi.quantity AS NUMERIC) AS quantity,
    SAFE_CAST(oi.sp AS NUMERIC) AS sp,
    SAFE_CAST(oi.brand_offer_sp AS NUMERIC) AS brand_offer_sp

  FROM `slikk-prod.slikkprodpublic.order_order` oo

  JOIN `slikk-prod.slikkprodpublic.order_orderitem` oi
    ON oo.id = oi.order_id

  JOIN `slikk-prod.slikkprodpublic.product_product` pp
    ON pp.id = oi.product_id

  JOIN `slikk-prod.slikkprodpublic.product_brand` pb
    ON pb.id = pp.brand_id

  JOIN `slikk-prod.slikksilver.product_tags` pt
    ON pt.product_id = pp.id

  LEFT JOIN `slikk-prod.slikkanalytics.silver_new_product_tags` nt
    ON nt.product_id = pp.id

  CROSS JOIN date_range d

  WHERE
    oo.status NOT IN ('OPEN', 'FAILED')
    AND oo.delivery_type != 'EXCHANGE'
    AND DATE(oo.create_date + INTERVAL 330 MINUTE) >= d.start_date
    AND DATE(oo.create_date + INTERVAL 330 MINUTE) < d.end_date
    AND LOWER(TRIM(nt.division)) = 'footwear'
    AND LOWER(TRIM(pb.name)) IN ('campus', 'liberty', 'red tape')
    AND pp.variant_id IS NOT NULL
),

-- =====================================================
-- 2. STYLE-WISE SALES + AVERAGE BRAND OFFER SP
-- =====================================================

style_sales AS (
  SELECT
    division,
    brand,
    style_code,

    -- AUG WEEK 1
    SUM(IF(order_date BETWEEN DATE '2026-08-01' AND DATE '2026-08-07', quantity, 0)) AS aug_w1_qty,
    SUM(IF(order_date BETWEEN DATE '2026-08-01' AND DATE '2026-08-07', sp * quantity, 0)) AS aug_w1_gmv,
    AVG(IF(order_date BETWEEN DATE '2026-08-01' AND DATE '2026-08-07', sp, NULL)) AS aug_w1_avg_sp,
    AVG(IF(order_date BETWEEN DATE '2026-08-01' AND DATE '2026-08-07', brand_offer_sp, NULL)) AS aug_w1_brand_offer_sp,
    -- AUG WEEK 2
    SUM(IF(order_date BETWEEN DATE '2026-08-08' AND DATE '2026-08-14', quantity, 0)) AS aug_w2_qty,
    SUM(IF(order_date BETWEEN DATE '2026-08-08' AND DATE '2026-08-14', sp * quantity, 0)) AS aug_w2_gmv,
    AVG(IF(order_date BETWEEN DATE '2026-08-08' AND DATE '2026-08-14', sp, NULL)) AS aug_w2_avg_sp,
    AVG(IF(order_date BETWEEN DATE '2026-08-08' AND DATE '2026-08-14', brand_offer_sp, NULL)) AS aug_w2_brand_offer_sp,
    -- AUG WEEK 3
    SUM(IF(order_date BETWEEN DATE '2026-08-15' AND DATE '2026-08-21', quantity, 0)) AS aug_w3_qty,
    SUM(IF(order_date BETWEEN DATE '2026-08-15' AND DATE '2026-08-21', sp * quantity, 0)) AS aug_w3_gmv,
    AVG(IF(order_date BETWEEN DATE '2026-08-15' AND DATE '2026-08-21', sp, NULL)) AS aug_w3_avg_sp,
    AVG(IF(order_date BETWEEN DATE '2026-08-15' AND DATE '2026-08-21', brand_offer_sp, NULL)) AS aug_w3_brand_offer_sp,
    -- AUG TOTAL (FIRST 21 DAYS)
    SUM(IF(order_date BETWEEN DATE '2026-08-01' AND DATE '2026-08-21', quantity, 0)) AS aug_total_qty,
    SUM(IF(order_date BETWEEN DATE '2026-08-01' AND DATE '2026-08-21', sp * quantity, 0)) AS aug_total_gmv,
    AVG(IF(order_date BETWEEN DATE '2026-08-01' AND DATE '2026-08-21', sp, NULL)) AS aug_total_avg_sp,
    AVG(IF(order_date BETWEEN DATE '2026-08-01' AND DATE '2026-08-21', brand_offer_sp, NULL)) AS aug_total_brand_offer_sp,

    -- SEPTEMBER WEEK 1
    SUM(IF(order_date BETWEEN DATE '2026-09-01' AND DATE '2026-09-07',
      quantity, 0)) AS sep_w1_qty,
    SUM(IF(order_date BETWEEN DATE '2026-09-01' AND DATE '2026-09-07',
      sp * quantity, 0)) AS sep_w1_gmv,
    AVG(IF(order_date BETWEEN DATE '2026-09-01' AND DATE '2026-09-07', sp, NULL)) AS sep_w1_avg_sp,

    AVG(IF(order_date BETWEEN DATE '2026-09-01' AND DATE '2026-09-07', brand_offer_sp, NULL)) AS sep_w1_brand_offer_sp,

    -- SEPTEMBER WEEK 2
    SUM(IF(order_date BETWEEN DATE '2026-09-08' AND DATE '2026-09-14',
      quantity, 0)) AS sep_w2_qty,
    SUM(IF(order_date BETWEEN DATE '2026-09-08' AND DATE '2026-09-14',
      sp * quantity, 0)) AS sep_w2_gmv,
    AVG(IF(order_date BETWEEN DATE '2026-09-08' AND DATE '2026-09-14', sp, NULL)) AS sep_w2_avg_sp,

    AVG(IF(order_date BETWEEN DATE '2026-09-08' AND DATE '2026-09-14', brand_offer_sp, NULL)) AS sep_w2_brand_offer_sp,

    -- SEPTEMBER WEEK 3
    SUM(IF(order_date BETWEEN DATE '2026-09-15' AND DATE '2026-09-21',
      quantity, 0)) AS sep_w3_qty,
    SUM(IF(order_date BETWEEN DATE '2026-09-15' AND DATE '2026-09-21',
      sp * quantity, 0)) AS sep_w3_gmv,
    AVG(IF(order_date BETWEEN DATE '2026-09-15' AND DATE '2026-09-21', sp, NULL)) AS sep_w3_avg_sp,

    AVG(IF(order_date BETWEEN DATE '2026-09-15' AND DATE '2026-09-21', brand_offer_sp, NULL)) AS sep_w3_brand_offer_sp,

    -- SEPTEMBER TOTAL
    SUM(IF(order_date BETWEEN DATE '2026-09-01' AND DATE '2026-09-21',
      quantity, 0)) AS sep_total_qty,
    SUM(IF(order_date BETWEEN DATE '2026-09-01' AND DATE '2026-09-21',
      sp * quantity, 0)) AS sep_total_gmv,
    AVG(IF(order_date BETWEEN DATE '2026-09-01' AND DATE '2026-09-21', sp, NULL)) AS sep_total_avg_sp,

    AVG(IF(order_date BETWEEN DATE '2026-09-01' AND DATE '2026-09-21', brand_offer_sp, NULL)) AS sep_total_brand_offer_sp,

    -- OCTOBER WEEK 1
    SUM(IF(order_date BETWEEN DATE '2026-10-01' AND DATE '2026-10-07',
      quantity, 0)) AS oct_w1_qty,
    SUM(IF(order_date BETWEEN DATE '2026-10-01' AND DATE '2026-10-07',
      sp * quantity, 0)) AS oct_w1_gmv,
    AVG(IF(order_date BETWEEN DATE '2026-10-01' AND DATE '2026-10-07', sp, NULL)) AS oct_w1_avg_sp,

    AVG(IF(order_date BETWEEN DATE '2026-10-01' AND DATE '2026-10-07', brand_offer_sp, NULL)) AS oct_w1_brand_offer_sp,

    -- OCTOBER WEEK 2
    SUM(IF(order_date BETWEEN DATE '2026-10-08' AND DATE '2026-10-14',
      quantity, 0)) AS oct_w2_qty,
    SUM(IF(order_date BETWEEN DATE '2026-10-08' AND DATE '2026-10-14',
      sp * quantity, 0)) AS oct_w2_gmv,
    AVG(IF(order_date BETWEEN DATE '2026-10-08' AND DATE '2026-10-14', sp, NULL)) AS oct_w2_avg_sp,

    AVG(IF(order_date BETWEEN DATE '2026-10-08' AND DATE '2026-10-14', brand_offer_sp, NULL)) AS oct_w2_brand_offer_sp,

    -- OCTOBER WEEK 3
    SUM(IF(order_date BETWEEN DATE '2026-10-15' AND DATE '2026-10-21',
      quantity, 0)) AS oct_w3_qty,
    SUM(IF(order_date BETWEEN DATE '2026-10-15' AND DATE '2026-10-21',
      sp * quantity, 0)) AS oct_w3_gmv,
    AVG(IF(order_date BETWEEN DATE '2026-10-15' AND DATE '2026-10-21', sp, NULL)) AS oct_w3_avg_sp,

    AVG(IF(order_date BETWEEN DATE '2026-10-15' AND DATE '2026-10-21', brand_offer_sp, NULL)) AS oct_w3_brand_offer_sp,

    -- OCTOBER TOTAL
    SUM(IF(order_date BETWEEN DATE '2026-10-01' AND DATE '2026-10-21',
      quantity, 0)) AS oct_total_qty,
    SUM(IF(order_date BETWEEN DATE '2026-10-01' AND DATE '2026-10-21',
      sp * quantity, 0)) AS oct_total_gmv,
    AVG(IF(order_date BETWEEN DATE '2026-10-01' AND DATE '2026-10-21', sp, NULL)) AS oct_total_avg_sp,

    AVG(IF(order_date BETWEEN DATE '2026-10-01' AND DATE '2026-10-21', brand_offer_sp, NULL)) AS oct_total_brand_offer_sp,

    -- NOVEMBER WEEK 1
    SUM(IF(order_date BETWEEN DATE '2026-11-01' AND DATE '2026-11-07',
      quantity, 0)) AS nov_w1_qty,
    SUM(IF(order_date BETWEEN DATE '2026-11-01' AND DATE '2026-11-07',
      sp * quantity, 0)) AS nov_w1_gmv,
    AVG(IF(order_date BETWEEN DATE '2026-11-01' AND DATE '2026-11-07', sp, NULL)) AS nov_w1_avg_sp,

    AVG(IF(order_date BETWEEN DATE '2026-11-01' AND DATE '2026-11-07', brand_offer_sp, NULL)) AS nov_w1_brand_offer_sp,

    -- NOVEMBER WEEK 2
    SUM(IF(order_date BETWEEN DATE '2026-11-08' AND DATE '2026-11-14',
      quantity, 0)) AS nov_w2_qty,
    SUM(IF(order_date BETWEEN DATE '2026-11-08' AND DATE '2026-11-14',
      sp * quantity, 0)) AS nov_w2_gmv,
    AVG(IF(order_date BETWEEN DATE '2026-11-08' AND DATE '2026-11-14', sp, NULL)) AS nov_w2_avg_sp,

    AVG(IF(order_date BETWEEN DATE '2026-11-08' AND DATE '2026-11-14', brand_offer_sp, NULL)) AS nov_w2_brand_offer_sp,

    -- NOVEMBER WEEK 3
    SUM(IF(order_date BETWEEN DATE '2026-11-15' AND DATE '2026-11-21',
      quantity, 0)) AS nov_w3_qty,
    SUM(IF(order_date BETWEEN DATE '2026-11-15' AND DATE '2026-11-21',
      sp * quantity, 0)) AS nov_w3_gmv,
    AVG(IF(order_date BETWEEN DATE '2026-11-15' AND DATE '2026-11-21', sp, NULL)) AS nov_w3_avg_sp,

    AVG(IF(order_date BETWEEN DATE '2026-11-15' AND DATE '2026-11-21', brand_offer_sp, NULL)) AS nov_w3_brand_offer_sp,

    -- NOVEMBER TOTAL
    SUM(IF(order_date BETWEEN DATE '2026-11-01' AND DATE '2026-11-21',
      quantity, 0)) AS nov_total_qty,
    SUM(IF(order_date BETWEEN DATE '2026-11-01' AND DATE '2026-11-21',
      sp * quantity, 0)) AS nov_total_gmv,
    AVG(IF(order_date BETWEEN DATE '2026-11-01' AND DATE '2026-11-21', sp, NULL)) AS nov_total_avg_sp,

    AVG(IF(order_date BETWEEN DATE '2026-11-01' AND DATE '2026-11-21', brand_offer_sp, NULL)) AS nov_total_brand_offer_sp

  FROM base
  GROUP BY division, brand, style_code
),

-- =====================================================
-- 3. INVENTORY: SKU + COMPANY + DATE + STORE
-- =====================================================

sku_in_stock_days AS (
  SELECT
    sku,
    company_code,
    create_date,
    store_code,
    SUM(quantity) AS qty

  FROM `slikk-prod.slikkprodpublic.product_inventorysnapshot`

  WHERE
    create_date >= DATE '2026-08-01'
    AND create_date <= DATE '2026-11-21'

  GROUP BY 1, 2, 3, 4
),

-- =====================================================
-- 4. MAP INVENTORY SKU TO STYLE CODE
-- SUM ACROSS ALL SKUS, COMPANIES AND STORES
-- =====================================================

inventory_style_day AS (
  SELECT
    nt.division,
    pb.name AS brand,
    pp.variant_id AS style_code,
    inv.create_date AS stock_date,
    SUM(SAFE_CAST(inv.qty AS NUMERIC)) AS daily_stock

  FROM sku_in_stock_days inv

  JOIN `slikk-prod.slikkprodpublic.product_product` pp
    ON LOWER(TRIM(CAST(inv.sku AS STRING))) =
       LOWER(TRIM(CAST(pp.sku AS STRING)))

  JOIN `slikk-prod.slikkprodpublic.product_brand` pb
    ON pb.id = pp.brand_id

  LEFT JOIN `slikk-prod.slikkanalytics.silver_new_product_tags` nt
    ON nt.product_id = pp.id

  WHERE
    LOWER(TRIM(nt.division)) = 'footwear'
    AND LOWER(TRIM(pb.name)) IN ('campus', 'liberty', 'red tape')
    AND pp.variant_id IS NOT NULL

  GROUP BY
    nt.division,
    pb.name,
    pp.variant_id,
    inv.create_date
),

-- =====================================================
-- 5. CALENDAR FOR SALES STYLES
-- ENSURES MISSING SNAPSHOT DAYS COUNT AS ZERO
-- =====================================================

style_calendar AS (
  SELECT
    s.division,
    s.brand,
    s.style_code,
    stock_date

  FROM (
    SELECT DISTINCT division, brand, style_code
    FROM style_sales
  ) s

  CROSS JOIN UNNEST(
    GENERATE_DATE_ARRAY(DATE '2026-08-01', DATE '2026-11-21')
  ) AS stock_date
),

-- =====================================================
-- 6. AVERAGE DAILY INVENTORY BY STYLE AND PERIOD
-- =====================================================

style_inventory AS (
  SELECT
    c.division,
    c.brand,
    c.style_code,

    -- AUGUST WEEKLY AND TOTAL
    AVG(IF(c.stock_date BETWEEN DATE '2026-08-01' AND DATE '2026-08-07', COALESCE(i.daily_stock, 0), NULL)) AS aug_w1_avg_inventory,
    AVG(IF(c.stock_date BETWEEN DATE '2026-08-08' AND DATE '2026-08-14', COALESCE(i.daily_stock, 0), NULL)) AS aug_w2_avg_inventory,
    AVG(IF(c.stock_date BETWEEN DATE '2026-08-15' AND DATE '2026-08-21', COALESCE(i.daily_stock, 0), NULL)) AS aug_w3_avg_inventory,
    AVG(IF(c.stock_date BETWEEN DATE '2026-08-01' AND DATE '2026-08-21', COALESCE(i.daily_stock, 0), NULL)) AS aug_total_avg_inventory,

    -- SEPTEMBER WEEKLY AND TOTAL
    AVG(IF(c.stock_date BETWEEN DATE '2026-09-01' AND DATE '2026-09-07',
      COALESCE(i.daily_stock, 0), NULL)) AS sep_w1_avg_inventory,

    AVG(IF(c.stock_date BETWEEN DATE '2026-09-08' AND DATE '2026-09-14',
      COALESCE(i.daily_stock, 0), NULL)) AS sep_w2_avg_inventory,

    AVG(IF(c.stock_date BETWEEN DATE '2026-09-15' AND DATE '2026-09-21',
      COALESCE(i.daily_stock, 0), NULL)) AS sep_w3_avg_inventory,

    AVG(IF(c.stock_date BETWEEN DATE '2026-09-01' AND DATE '2026-09-21',
      COALESCE(i.daily_stock, 0), NULL)) AS sep_total_avg_inventory,

    -- OCTOBER WEEKLY AND TOTAL
    AVG(IF(c.stock_date BETWEEN DATE '2026-10-01' AND DATE '2026-10-07',
      COALESCE(i.daily_stock, 0), NULL)) AS oct_w1_avg_inventory,

    AVG(IF(c.stock_date BETWEEN DATE '2026-10-08' AND DATE '2026-10-14',
      COALESCE(i.daily_stock, 0), NULL)) AS oct_w2_avg_inventory,

    AVG(IF(c.stock_date BETWEEN DATE '2026-10-15' AND DATE '2026-10-21',
      COALESCE(i.daily_stock, 0), NULL)) AS oct_w3_avg_inventory,

    AVG(IF(c.stock_date BETWEEN DATE '2026-10-01' AND DATE '2026-10-21',
      COALESCE(i.daily_stock, 0), NULL)) AS oct_total_avg_inventory,

    -- NOVEMBER WEEKLY AND TOTAL
    AVG(IF(c.stock_date BETWEEN DATE '2026-11-01' AND DATE '2026-11-07',
      COALESCE(i.daily_stock, 0), NULL)) AS nov_w1_avg_inventory,

    AVG(IF(c.stock_date BETWEEN DATE '2026-11-08' AND DATE '2026-11-14',
      COALESCE(i.daily_stock, 0), NULL)) AS nov_w2_avg_inventory,

    AVG(IF(c.stock_date BETWEEN DATE '2026-11-15' AND DATE '2026-11-21',
      COALESCE(i.daily_stock, 0), NULL)) AS nov_w3_avg_inventory,

    AVG(IF(c.stock_date BETWEEN DATE '2026-11-01' AND DATE '2026-11-21',
      COALESCE(i.daily_stock, 0), NULL)) AS nov_total_avg_inventory

  FROM style_calendar c

  LEFT JOIN inventory_style_day i
    ON c.division = i.division
    AND c.brand = i.brand
    AND c.style_code = i.style_code
    AND c.stock_date = i.stock_date

  GROUP BY
    c.division,
    c.brand,
    c.style_code
),

-- =====================================================
-- 7. COMBINE PDP AND ATC EVENTS
-- =====================================================

all_events AS (
  SELECT
    'PDP' AS event_type,
    LOWER(TRIM(product_id)) AS event_product_id,
    DATE(create_date) AS event_date
  FROM `slikk-prod.slikksilver.silver_pdp_events`
  WHERE
    DATE(create_date) BETWEEN DATE '2026-08-01' AND DATE '2026-11-21'
    AND product_id IS NOT NULL

  UNION ALL

  SELECT
    'ATC' AS event_type,
    LOWER(TRIM(product_id)) AS event_product_id,
    DATE(create_date) AS event_date
  FROM `slikk-prod.slikksilver.silver_add_to_cart_events`
  WHERE
    DATE(create_date) BETWEEN DATE '2026-08-01' AND DATE '2026-11-21'
    AND product_id IS NOT NULL
),

-- =====================================================
-- 8. EVENT PRODUCT MAPPING: SKID > SKU > BARCODE
-- =====================================================

product_mapping AS (
  SELECT
    event_product_id,
    product_id
  FROM (
    SELECT
      e.event_product_id,
      pp.id AS product_id,

      ROW_NUMBER() OVER (
        PARTITION BY e.event_product_id
        ORDER BY
          CASE
            WHEN e.event_product_id = LOWER(TRIM(pp.skid)) THEN 1
            WHEN e.event_product_id = LOWER(TRIM(pp.sku)) THEN 2
            WHEN e.event_product_id = LOWER(TRIM(pp.barcode)) THEN 3
          END,
          pp.id
      ) AS rn

    FROM (
      SELECT DISTINCT event_product_id
      FROM all_events
    ) e

    JOIN `slikk-prod.slikkprodpublic.product_product` pp
      ON e.event_product_id = LOWER(TRIM(pp.skid))
      OR e.event_product_id = LOWER(TRIM(pp.sku))
      OR e.event_product_id = LOWER(TRIM(pp.barcode))
  )
  WHERE rn = 1
),

mapped_events AS (
  SELECT
    e.event_type,
    e.event_date,
    pm.product_id
  FROM all_events e
  JOIN product_mapping pm
    ON e.event_product_id = pm.event_product_id
),

-- =====================================================
-- 9. DEDUPLICATED PRODUCT TAGS FOR EVENTS
-- =====================================================

tags AS (
  SELECT
    product_id,
    ANY_VALUE(division) AS division
  FROM `slikk-prod.slikkanalytics.silver_new_product_tags`
  GROUP BY product_id
),

-- =====================================================
-- 10. STYLE-WISE WEEKLY AND MONTHLY PDP / ATC
-- =====================================================

style_events AS (
