    COUNTIF(event_type = 'PDP'
      AND event_date BETWEEN DATE '2026-11-08' AND DATE '2026-11-14')
      AS nov_w2_pdp,
    COUNTIF(event_type = 'ATC'
      AND event_date BETWEEN DATE '2026-11-08' AND DATE '2026-11-14')
      AS nov_w2_atc,

    COUNTIF(event_type = 'PDP'
      AND event_date BETWEEN DATE '2026-11-15' AND DATE '2026-11-21')
      AS nov_w3_pdp,
    COUNTIF(event_type = 'ATC'
      AND event_date BETWEEN DATE '2026-11-15' AND DATE '2026-11-21')
      AS nov_w3_atc,

    COUNTIF(event_type = 'PDP'
      AND event_date BETWEEN DATE '2026-11-01' AND DATE '2026-11-21')
      AS nov_total_pdp,
    COUNTIF(event_type = 'ATC'
      AND event_date BETWEEN DATE '2026-11-01' AND DATE '2026-11-21')
      AS nov_total_atc

  FROM mapped_events e

  JOIN `slikk-prod.slikkprodpublic.product_product` pp
    ON pp.id = e.product_id

  JOIN `slikk-prod.slikkprodpublic.product_brand` pb
    ON pb.id = pp.brand_id

  LEFT JOIN tags t
    ON t.product_id = pp.id

  WHERE
    LOWER(TRIM(t.division)) = 'footwear'
    AND LOWER(TRIM(pb.name)) IN ('campus', 'liberty', 'red tape')
    AND pp.variant_id IS NOT NULL

  GROUP BY
    t.division,
    pb.name,
    pp.variant_id
),

-- =====================================================
-- 11. COMBINE SALES + INVENTORY + PDP / ATC
-- =====================================================

combined AS (
  SELECT
    s.*,

    -- INVENTORY
    i.aug_w1_avg_inventory,
    i.aug_w2_avg_inventory,
    i.aug_w3_avg_inventory,
    i.aug_total_avg_inventory,

    i.sep_w1_avg_inventory,
    i.sep_w2_avg_inventory,
    i.sep_w3_avg_inventory,
    i.sep_total_avg_inventory,

    i.oct_w1_avg_inventory,
    i.oct_w2_avg_inventory,
    i.oct_w3_avg_inventory,
    i.oct_total_avg_inventory,

    i.nov_w1_avg_inventory,
    i.nov_w2_avg_inventory,
    i.nov_w3_avg_inventory,
    i.nov_total_avg_inventory,

    -- PDP / ATC
    COALESCE(e.aug_w1_pdp, 0) AS aug_w1_pdp,
    COALESCE(e.aug_w1_atc, 0) AS aug_w1_atc,
    COALESCE(e.aug_w2_pdp, 0) AS aug_w2_pdp,
    COALESCE(e.aug_w2_atc, 0) AS aug_w2_atc,
    COALESCE(e.aug_w3_pdp, 0) AS aug_w3_pdp,
    COALESCE(e.aug_w3_atc, 0) AS aug_w3_atc,
    COALESCE(e.aug_total_pdp, 0) AS aug_total_pdp,
    COALESCE(e.aug_total_atc, 0) AS aug_total_atc,
    COALESCE(e.sep_w1_pdp, 0) AS sep_w1_pdp,
    COALESCE(e.sep_w1_atc, 0) AS sep_w1_atc,
    COALESCE(e.sep_w2_pdp, 0) AS sep_w2_pdp,
    COALESCE(e.sep_w2_atc, 0) AS sep_w2_atc,
    COALESCE(e.sep_w3_pdp, 0) AS sep_w3_pdp,
    COALESCE(e.sep_w3_atc, 0) AS sep_w3_atc,
    COALESCE(e.sep_total_pdp, 0) AS sep_total_pdp,
    COALESCE(e.sep_total_atc, 0) AS sep_total_atc,

    COALESCE(e.oct_w1_pdp, 0) AS oct_w1_pdp,
    COALESCE(e.oct_w1_atc, 0) AS oct_w1_atc,
    COALESCE(e.oct_w2_pdp, 0) AS oct_w2_pdp,
    COALESCE(e.oct_w2_atc, 0) AS oct_w2_atc,
    COALESCE(e.oct_w3_pdp, 0) AS oct_w3_pdp,
    COALESCE(e.oct_w3_atc, 0) AS oct_w3_atc,
    COALESCE(e.oct_total_pdp, 0) AS oct_total_pdp,
    COALESCE(e.oct_total_atc, 0) AS oct_total_atc,

    COALESCE(e.nov_w1_pdp, 0) AS nov_w1_pdp,
    COALESCE(e.nov_w1_atc, 0) AS nov_w1_atc,
    COALESCE(e.nov_w2_pdp, 0) AS nov_w2_pdp,
    COALESCE(e.nov_w2_atc, 0) AS nov_w2_atc,
    COALESCE(e.nov_w3_pdp, 0) AS nov_w3_pdp,
    COALESCE(e.nov_w3_atc, 0) AS nov_w3_atc,
    COALESCE(e.nov_total_pdp, 0) AS nov_total_pdp,
    COALESCE(e.nov_total_atc, 0) AS nov_total_atc

  FROM style_sales s

  LEFT JOIN style_inventory i
    ON s.division = i.division
    AND s.brand = i.brand
    AND s.style_code = i.style_code

  LEFT JOIN style_events e
    ON s.division = e.division
    AND s.brand = e.brand
    AND s.style_code = e.style_code
),

-- =====================================================
-- 12. COMBINED GMV AND BRAND-WISE RANKING
-- =====================================================

ranked AS (
  SELECT
    *,

    aug_total_gmv + sep_total_gmv + oct_total_gmv + nov_total_gmv AS total_gmv,

    SUM(aug_total_gmv + sep_total_gmv + oct_total_gmv + nov_total_gmv) OVER (
      PARTITION BY brand
      ORDER BY
        aug_total_gmv + sep_total_gmv + oct_total_gmv + nov_total_gmv DESC,
        CAST(style_code AS STRING)
      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ) AS cumulative_gmv,

    SUM(aug_total_gmv + sep_total_gmv + oct_total_gmv + nov_total_gmv) OVER (
      PARTITION BY brand
    ) AS brand_total_gmv

  FROM combined
),

-- =====================================================
-- 13. GRADING
-- =====================================================

graded AS (
  SELECT
    *,
    SAFE_DIVIDE(cumulative_gmv, brand_total_gmv) AS cumulative_gmv_share,

    CASE
      WHEN SAFE_DIVIDE(cumulative_gmv, brand_total_gmv) <= 0.30 THEN 'A'
      WHEN SAFE_DIVIDE(cumulative_gmv, brand_total_gmv) <= 0.55 THEN 'B'
      WHEN SAFE_DIVIDE(cumulative_gmv, brand_total_gmv) <= 0.75 THEN 'C'
      WHEN SAFE_DIVIDE(cumulative_gmv, brand_total_gmv) <= 0.90 THEN 'D'
      ELSE 'E'
    END AS grade

  FROM ranked
)

-- =====================================================
-- 14. FINAL OUTPUT
-- Existing KPIs + Average Inventory + Average Brand Offer SP
-- =====================================================

SELECT
  division,
  brand,
  CAST(style_code AS STRING) AS style_code,

  -- AUGUST WEEK 1
