  ROUND(sep_w2_gmv / 100000, 2) AS sep_w2_gmv_lakhs,
  sep_w2_pdp,
  sep_w2_atc,
  ROUND(COALESCE(SAFE_DIVIDE(sep_w2_atc, sep_w2_pdp) * 100, 0), 2)
    AS sep_w2_pdp_to_atc_pct,
  ROUND(COALESCE(SAFE_DIVIDE(sep_w2_qty, sep_w2_pdp) * 100, 0), 2)
    AS sep_w2_cvr_pct,
  ROUND(sep_w2_avg_inventory, 2) AS sep_w2_avg_inventory,
  ROUND(sep_w2_avg_sp, 2) AS sep_w2_avg_sp,

  ROUND(sep_w2_brand_offer_sp, 2) AS sep_w2_avg_brand_offer_sp,

  -- SEPTEMBER WEEK 3
