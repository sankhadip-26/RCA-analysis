  ROUND(COALESCE(SAFE_DIVIDE(oct_w1_qty, oct_w1_pdp) * 100, 0), 2)
    AS oct_w1_cvr_pct,
  ROUND(oct_w1_avg_inventory, 2) AS oct_w1_avg_inventory,
  ROUND(oct_w1_avg_sp, 2) AS oct_w1_avg_sp,

  ROUND(oct_w1_brand_offer_sp, 2) AS oct_w1_avg_brand_offer_sp,

  -- OCTOBER WEEK 2
  oct_w2_qty,
  ROUND(oct_w2_gmv / 100000, 2) AS oct_w2_gmv_lakhs,
  oct_w2_pdp,
